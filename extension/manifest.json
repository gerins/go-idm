{
  "manifest_version": 3,
  "name": "GoIDM Integration",
  "version": "0.1.0",
  "description": "Send browser downloads to GoIDM, the desktop download manager.",
  "minimum_chrome_version": "110",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "GoIDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
